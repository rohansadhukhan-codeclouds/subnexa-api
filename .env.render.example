# Copy these into the Render Dashboard → Environment.
# Never commit real values. Generate APP_KEY locally:
#   php artisan key:generate --show

APP_NAME=Subnexa
APP_ENV=production
APP_DEBUG=false
APP_KEY=base64:REPLACE_WITH_php_artisan_key_generate_show
APP_URL=https://YOUR-SERVICE.onrender.com
FRONTEND_URL=https://YOUR-FRONTEND.vercel.app

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stderr
LOG_LEVEL=info

# Prefer an external MySQL (TiDB Cloud / Aiven / PlanetScale-compatible, etc.)
# Postgres also works if you set DB_CONNECTION=pgsql and use a free external DB.
DB_CONNECTION=mysql
DB_HOST=YOUR_DB_HOST
DB_PORT=3306
DB_DATABASE=subnexa
DB_USERNAME=YOUR_DB_USER
DB_PASSWORD=YOUR_DB_PASSWORD
# Optional single URL instead of discrete fields (Laravel DB_URL):
# DB_URL=mysql://USER:PASSWORD@HOST:3306/subnexa

# Demo admin used only when you manually run: php artisan db:seed --force
# Change these before seeding. Do not keep the local defaults in production.
ADMIN_NAME=Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=REPLACE_WITH_A_STRONG_PASSWORD

# Free-tier friendly: no Redis, no background worker
SESSION_DRIVER=database
SESSION_LIFETIME=120
CACHE_STORE=database
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local
BROADCAST_CONNECTION=log
MAIL_MAILER=log

# Optional container flags (set in Render env)
# Cache Laravel config after deploy (recommended once APP_* and DB_* are correct)
CACHE_CONFIG=true
# Set true only for a one-shot deploy if you want migrate on boot, then set back to false
RUN_MIGRATIONS=false

# Render injects PORT automatically. Default in the image is 10000.
# PORT=10000

# Copy these into the Render Dashboard → Environment.
# Never commit real passwords. Generate APP_KEY locally:
#   php artisan key:generate --show

APP_NAME=Subnexa
APP_ENV=production
APP_DEBUG=false
APP_KEY=base64:REPLACE_WITH_php_artisan_key_generate_show
APP_URL=https://YOUR-SERVICE.onrender.com
FRONTEND_URL=https://YOUR-FRONTEND.vercel.app

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stderr
LOG_LEVEL=info

# -----------------------------------------------------------------------------
# Neon PostgreSQL (production)
# Leave DB_URL empty when using discrete fields. A stale MySQL DB_URL overrides
# host/database and will break this connection.
# -----------------------------------------------------------------------------
DB_CONNECTION=pgsql
DB_HOST=ep-round-glade-bbx5cb6e.c-15.us-east-1.aws.neon.tech
DB_PORT=5432
DB_DATABASE=neondb
DB_USERNAME=neondb_owner
DB_PASSWORD=SET_IN_RENDER_ENVIRONMENT
DB_SSLMODE=require
DB_CHANNEL_BINDING=require
# DB_URL=

# Optional Neon URI form instead of discrete fields (password redacted):
# DB_URL=postgresql://neondb_owner:PASSWORD@ep-round-glade-bbx5cb6e.c-15.us-east-1.aws.neon.tech:5432/neondb?sslmode=require&channel_binding=require

# Demo admin used only when you manually run: php artisan db:seed --force
# Use a strong unique password. Do not keep local defaults in production.
ADMIN_NAME=Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=REPLACE_WITH_A_STRONG_PASSWORD

# Free-tier friendly: no Redis, no background worker
SESSION_DRIVER=database
SESSION_LIFETIME=120
CACHE_STORE=database
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local
BROADCAST_CONNECTION=log
MAIL_MAILER=log

# Optional container flags
CACHE_CONFIG=true
# One-shot only: set true for a single deploy to create tables, then set false
RUN_MIGRATIONS=false

# Render injects PORT automatically. Image default is 10000.
# PORT=10000

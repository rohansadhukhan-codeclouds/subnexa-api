# Git / IDE
.git
.gitattributes
.gitignore
.idea
.vscode
.cursor
.codex
.zed
.nova
# Local env and secrets — never bake into the image
.env
.env.*
!.env.example
!.env.render.example
auth.json

# Dependencies installed inside the image
/vendor
/node_modules

# Frontend build tooling (API does not need Vite assets at runtime)
/public/hot
/public/build
npm-debug.log
yarn-error.log
package-lock.json

# Local / test artifacts
.phpunit.cache
.phpunit.result.cache
.phpactor.json
phpunit.xml
/tests
/database/*.sqlite
/database/*.sqlite-journal
Homestead.json
Homestead.yaml
_ide_helper.php

# Runtime storage noise (dirs recreated in the image)
/storage/logs/*
/storage/framework/cache/data/*
/storage/framework/sessions/*
/storage/framework/views/*
/storage/pail
!/storage/logs/.gitignore
!/storage/framework/cache/data/.gitignore
!/storage/framework/sessions/.gitignore
!/storage/framework/views/.gitignore
/bootstrap/cache/*.php

# Compose file is for local use only (Dockerfile still builds without it)
docker-compose*.yml
